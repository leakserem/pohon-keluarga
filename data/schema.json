{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Family Tree v2 Data Schema",
  "description": "Schema data untuk aplikasi Family Tree v2",
  "type": "object",
  "required": [
    "app",
    "members"
  ],
  "properties": {
    "app": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "required": [
        "id",
        "name",
        "gender",
        "generation",
        "father",
        "mother",
        "spouse",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "gender": {
          "type": "string",
          "enum": [
            "male",
            "female"
          ]
        },
        "birthDate": {
          "type": "string"
        },
        "deathDate": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "father": {
          "type": [
            "string",
            "null"
          ]
        },
        "mother": {
          "type": [
            "string",
            "null"
          ]
        },
        "spouse": {
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "photo": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
